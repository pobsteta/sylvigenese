{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylvigenese:cell_sheet",
  "title": "Fiches de cellule d'une tuile (web/cells/<tuile>.json, assets)",
  "description": "Ce que la vue web affiche pour une cellule : station, type de végétation, composition, volume, carbone, mention provisoire, par année (spec §1, §9, §10). La commande viewer-massif se construit dans la vue à partir de x, y et de l'année.",
  "x-schema-version": "0.1",
  "type": "object",
  "required": ["schema_version", "tile", "cells"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "tile": {"type": "string", "minLength": 1},
    "cells": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "x-lambert93": true,
        "required": ["cell_id", "x", "y", "station_type", "vegetation_type", "years"],
        "additionalProperties": false,
        "properties": {
          "cell_id": {"description": "rang de la cellule dans grid.tif", "type": "integer", "minimum": 0},
          "x": {"description": "x Lambert-93 du centre de la cellule (est), m", "type": "number"},
          "y": {"description": "y Lambert-93 du centre de la cellule (nord), m", "type": "number"},
          "station_type": {"type": "string", "minLength": 1},
          "vegetation_type": {"type": "string", "minLength": 1},
          "years": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["year", "provisoire", "composition", "volume_m3_ha", "carbon_t_ha"],
              "additionalProperties": false,
              "properties": {
                "year": {"type": "integer"},
                "provisoire": {"type": "boolean"},
                "composition": {
                  "type": "array",
                  "items": {
                    "type": "object", "required": ["species", "share"], "additionalProperties": false,
                    "properties": {
                      "species": {"type": "string", "pattern": "^[0-9]{2}[A-Z0-9]{0,3}$"},
                      "share": {"type": "number", "minimum": 0, "maximum": 1}
                    }
                  }
                },
                "volume_m3_ha": {"description": "null = non calculé (post, après la simulation) ; la fiche le dit dans notes", "type": ["number", "null"], "minimum": 0},
                "carbon_t_ha": {"description": "null = non calculé (post, après la simulation) ; la fiche le dit dans notes", "type": ["number", "null"], "minimum": 0},
                "h0_m": {"description": "hauteur dominante de la cellule (h0.tif), m", "type": "number", "minimum": 0},
                "density_trees_ha": {"description": "arbres détectés par hectare", "type": "number", "minimum": 0},
                "notes": {"description": "mentions affichées avec la fiche (valeurs vides, statut provisoire)", "type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    }
  }
}
