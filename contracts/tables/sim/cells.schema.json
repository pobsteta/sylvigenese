{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "title": "Cellules simulées (sim/cells/year=AAAA/*.parquet, simulate)",
  "description": "Par cellule, année et essence : tiges/ha, surface terrière, d moyen, semis/ha, hauteur des semis (BRIEF §4). cell_id : rang de la cellule dans grid.tif, ligne par ligne depuis le coin nord-ouest, à partir de 0.",
  "x-schema-version": "0.1",
  "x-names-fixed-by": "mission 009 (orchestrateur, par délégation de Pascal)",
  "fieldsMatch": "equal",
  "fields": [
    {
      "name": "cell_id",
      "type": "integer",
      "description": "rang de la cellule dans grid.tif (ligne × largeur + colonne)",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "year",
      "type": "integer",
      "description": "année simulée (égale à la partition year=AAAA)",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "species",
      "type": "string",
      "description": "code espar de l'IFN en chaîne, avec son zéro de tête (spec §8, contracts/species.csv)",
      "constraints": {
        "pattern": "[0-9]{2}[A-Z0-9]{0,3}",
        "required": true
      }
    },
    {
      "name": "stems_ha",
      "type": "number",
      "description": "tiges de 7,5 cm et plus",
      "x-unit": "tiges/ha",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "basal_area_m2_ha",
      "type": "number",
      "description": "surface terrière",
      "x-unit": "m2/ha",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "d130_mean",
      "type": "number",
      "description": "diamètre moyen ; vide sans tige",
      "x-unit": "cm",
      "constraints": {
        "exclusiveMinimum": 0
      }
    },
    {
      "name": "seedlings_ha",
      "type": "number",
      "description": "semis (moins de 7,5 cm)",
      "x-unit": "semis/ha",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "seedling_h_mean",
      "type": "number",
      "description": "hauteur moyenne des semis ; vide sans semis",
      "x-unit": "m",
      "constraints": {
        "exclusiveMinimum": 0
      }
    }
  ],
  "primaryKey": [
    "cell_id",
    "year",
    "species"
  ]
}
