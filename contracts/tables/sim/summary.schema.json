{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "title": "Résumé (sim/summary.parquet, post)",
  "description": "Volume, biomasse et carbone par cellule, année et essence, calculés par post avec le tarif (spec §2).",
  "x-schema-version": "0.1",
  "x-names-fixed-by": "mission 009 (orchestrateur, par délégation de Pascal)",
  "fieldsMatch": "equal",
  "fields": [
    {
      "name": "cell_id",
      "type": "integer",
      "description": "rang de la cellule dans grid.tif",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "year",
      "type": "integer",
      "description": "année simulée",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "species",
      "type": "string",
      "description": "code espar de l'IFN en chaîne, avec son zéro de tête (spec §8, contracts/species.csv)",
      "constraints": {
        "pattern": "[0-9]{2}[A-Z0-9]{0,3}",
        "required": true
      }
    },
    {
      "name": "volume_m3_ha",
      "type": "number",
      "description": "volume",
      "x-unit": "m3/ha",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "biomass_t_ha",
      "type": "number",
      "description": "biomasse sèche",
      "x-unit": "t/ha",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "carbon_t_ha",
      "type": "number",
      "description": "carbone",
      "x-unit": "tC/ha",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "provisoire",
      "type": "boolean",
      "description": "vrai si un paramètre provisoire a servi (spec §10)",
      "constraints": {
        "required": true
      }
    }
  ],
  "primaryKey": [
    "cell_id",
    "year",
    "species"
  ]
}
