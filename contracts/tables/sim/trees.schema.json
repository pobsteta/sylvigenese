{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "title": "Arbres simulés (sim/trees/year=AAAA/*.parquet, simulate)",
  "description": "Un arbre par ligne et par année (BRIEF §4). x et y en EPSG:2154 ; hcb et cw déduits par les allométries de tarif-nemeton.",
  "x-schema-version": "0.1",
  "x-names-fixed-by": "BRIEF §4 ; liste de status : mission 009",
  "fieldsMatch": "equal",
  "fields": [
    {
      "name": "tree_id",
      "type": "string",
      "description": "identifiant ; pour une recrue : (cellule, année, rang)",
      "constraints": {
        "required": true,
        "minLength": 1
      }
    },
    {
      "name": "year",
      "type": "integer",
      "description": "année simulée (égale à la partition year=AAAA)",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "species",
      "type": "string",
      "description": "code espar de l'IFN en chaîne, avec son zéro de tête (spec §8, contracts/species.csv)",
      "constraints": {
        "pattern": "[0-9]{2}[A-Z0-9]{0,3}",
        "required": true
      }
    },
    {
      "name": "x",
      "type": "number",
      "description": "x Lambert-93 (est)",
      "x-unit": "m",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "y",
      "type": "number",
      "description": "y Lambert-93 (nord)",
      "x-unit": "m",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "d130",
      "type": "number",
      "description": "diamètre à 1,30 m",
      "x-unit": "cm",
      "constraints": {
        "required": true,
        "exclusiveMinimum": 0
      }
    },
    {
      "name": "h",
      "type": "number",
      "description": "hauteur",
      "x-unit": "m",
      "constraints": {
        "required": true,
        "exclusiveMinimum": 0
      }
    },
    {
      "name": "hcb",
      "type": "number",
      "description": "hauteur de la base du houppier",
      "x-unit": "m",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "cw",
      "type": "number",
      "description": "largeur du houppier",
      "x-unit": "m",
      "constraints": {
        "required": true,
        "minimum": 0
      }
    },
    {
      "name": "status",
      "type": "string",
      "description": "état de l'arbre à la fin de l'année",
      "constraints": {
        "required": true,
        "enum": [
          "alive",
          "dead"
        ]
      }
    }
  ],
  "primaryKey": [
    "tree_id",
    "year"
  ],
  "x-extent": {
    "x": "x",
    "y": "y"
  }
}
