{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "title": "Arbres détectés (trees_init/, prepare)",
  "description": "Arbres détectés sur le MNH à 50 cm ; d130 par la méthode de l'étage B de tarif-nemeton (spec §4 ; BRIEF §4). x et y en EPSG:2154.",
  "x-schema-version": "0.1",
  "x-names-fixed-by": "BRIEF §4 et spec §4 ; listes fermées : orchestrateur (mission 009)",
  "fieldsMatch": "equal",
  "fields": [
    {
      "name": "tree_id",
      "type": "string",
      "description": "identifiant de l'arbre",
      "constraints": {
        "required": true,
        "minLength": 1,
        "unique": true
      }
    },
    {
      "name": "x",
      "type": "number",
      "description": "x Lambert-93 (est)",
      "x-unit": "m",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "y",
      "type": "number",
      "description": "y Lambert-93 (nord)",
      "x-unit": "m",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "species",
      "type": "string",
      "description": "code espar de l'IFN en chaîne, avec son zéro de tête (spec §8, contracts/species.csv)",
      "constraints": {
        "pattern": "[0-9]{2}[A-Z0-9]{0,3}",
        "required": true
      }
    },
    {
      "name": "d130",
      "type": "number",
      "description": "diamètre à 1,30 m",
      "x-unit": "cm",
      "constraints": {
        "required": true,
        "exclusiveMinimum": 0
      }
    },
    {
      "name": "h",
      "type": "number",
      "description": "hauteur lue sur le MNH",
      "x-unit": "m",
      "constraints": {
        "required": true,
        "exclusiveMinimum": 0
      }
    },
    {
      "name": "species_source",
      "type": "string",
      "description": "origine de l'essence",
      "constraints": {
        "required": true,
        "enum": [
          "nemeton",
          "vegetation_type",
          "inventaire_video"
        ]
      }
    },
    {
      "name": "d130_source",
      "type": "string",
      "description": "origine du d130",
      "constraints": {
        "required": true,
        "enum": [
          "tarif_etage_b",
          "inventaire_video",
          "nemeton"
        ]
      }
    }
  ],
  "primaryKey": [
    "tree_id"
  ],
  "x-extent": {
    "x": "x",
    "y": "y"
  }
}
