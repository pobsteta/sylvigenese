{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "title": "Arbres IFN préparés (ifn/trees.parquet)",
  "description": "d130 = C13 / (10 π), C13 en mm (docs/referentiels/ifn-placettes.md §2).",
  "x-schema-version": "0.1",
  "x-names-fixed-by": "mission 009 (orchestrateur, par délégation de Pascal)",
  "fieldsMatch": "equal",
  "fields": [
    {
      "name": "plot_id",
      "type": "string",
      "description": "identifiant de placette (IDP)",
      "constraints": {
        "required": true,
        "minLength": 1
      }
    },
    {
      "name": "campaign",
      "type": "integer",
      "description": "année de la campagne",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "tree_id",
      "type": "string",
      "description": "identifiant de l'arbre dans la placette",
      "constraints": {
        "required": true,
        "minLength": 1
      }
    },
    {
      "name": "species",
      "type": "string",
      "description": "code espar de l'IFN en chaîne, avec son zéro de tête (spec §8, contracts/species.csv)",
      "constraints": {
        "pattern": "[0-9]{2}[A-Z0-9]{0,3}",
        "required": true
      }
    },
    {
      "name": "d130",
      "type": "number",
      "description": "diamètre à 1,30 m",
      "x-unit": "cm",
      "constraints": {
        "required": true,
        "exclusiveMinimum": 0
      }
    },
    {
      "name": "h",
      "type": "number",
      "description": "hauteur totale (HTOT), si mesurée",
      "x-unit": "m",
      "constraints": {
        "exclusiveMinimum": 0
      }
    },
    {
      "name": "weight_ha",
      "type": "number",
      "description": "poids de l'arbre (W)",
      "x-unit": "tiges/ha",
      "constraints": {
        "minimum": 0
      }
    }
  ],
  "primaryKey": [
    "plot_id",
    "campaign",
    "tree_id"
  ]
}
