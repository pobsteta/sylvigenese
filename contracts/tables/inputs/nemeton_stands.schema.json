{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "title": "Peuplements nemeton (inputs/nemeton_stands.gpkg, couche stands)",
  "description": "Export des polygones nemeton par la fonction R fournie par prepare. Un polygone porte une seule essence (spec §3, §4).",
  "x-schema-version": "0.1",
  "x-names-fixed-by": "docs/spec.md §3",
  "fieldsMatch": "equal",
  "fields": [
    {
      "name": "stand_id",
      "type": "string",
      "description": "identifiant du polygone",
      "constraints": {
        "required": true,
        "minLength": 1,
        "unique": true
      }
    },
    {
      "name": "species_espar",
      "type": "string",
      "description": "code espar de l'IFN en chaîne, avec son zéro de tête (spec §8, contracts/species.csv)",
      "constraints": {
        "pattern": "[0-9]{2}[A-Z0-9]{0,3}",
        "required": true
      }
    },
    {
      "name": "dbh_cm",
      "type": "number",
      "description": "diamètre moyen à 1,30 m",
      "x-unit": "cm",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "height_m",
      "type": "number",
      "description": "hauteur",
      "x-unit": "m",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "density_ha",
      "type": "number",
      "description": "densité",
      "x-unit": "tiges/ha",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "age_yr",
      "type": "integer",
      "description": "âge",
      "x-unit": "an",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "source",
      "type": "string",
      "description": "origine de la donnée (inventaire, synthetic_ml, …) : liste ouverte, non vide",
      "constraints": {
        "required": true,
        "minLength": 1
      }
    },
    {
      "name": "stand_id_source",
      "type": "string",
      "description": "identifiant du polygone dans sa source"
    }
  ],
  "x-geopackage": {
    "layer": "stands",
    "geometry_types": [
      "POLYGON",
      "MULTIPOLYGON"
    ],
    "srs_epsg": 2154
  }
}
