{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "title": "Inventaire vidéo nemeton, couche arbres (schéma nemeton 1.7.0)",
  "description": "Colonnes utilisées par sylvigenese ; domaines repris du schéma nemeton (docs/referentiels/entrees-externes.csv, lignes 2 à 13).",
  "x-schema-version": "0.1",
  "x-names-fixed-by": "nemeton, inst/inventaire_video/inventaire_video.schema.json 1.7.0",
  "fieldsMatch": "subset",
  "fields": [
    {
      "name": "plot_id",
      "type": "string",
      "description": "identifiant de placette",
      "constraints": {
        "required": true,
        "minLength": 1
      }
    },
    {
      "name": "tree_id",
      "type": "string",
      "description": "identifiant de l'arbre",
      "constraints": {
        "required": true,
        "minLength": 1,
        "unique": true
      }
    },
    {
      "name": "essence_arbre",
      "type": "string",
      "description": "code libre français snake_case de nemeton (ni espar ni CD_REF)"
    },
    {
      "name": "dbh_cm",
      "type": "number",
      "description": "diamètre à 1,30 m",
      "x-unit": "cm",
      "constraints": {
        "minimum": 0,
        "maximum": 1000
      }
    },
    {
      "name": "dbh_source",
      "type": "string",
      "description": "origine du diamètre",
      "constraints": {
        "enum": [
          "estime",
          "mesure"
        ]
      }
    },
    {
      "name": "h_m",
      "type": "number",
      "description": "hauteur",
      "x-unit": "m",
      "constraints": {
        "minimum": 0,
        "maximum": 80
      }
    },
    {
      "name": "h_source",
      "type": "string",
      "description": "origine de la hauteur",
      "constraints": {
        "enum": [
          "mnh",
          "mesuree",
          "aucune"
        ]
      }
    },
    {
      "name": "statut",
      "type": "string",
      "description": "état de l'arbre",
      "constraints": {
        "enum": [
          "vivant",
          "mort",
          "chablis",
          "coupe"
        ]
      }
    }
  ],
  "x-geopackage": {
    "layer": "arbres",
    "geometry_types": [
      "POINT"
    ],
    "srs_epsg": 2154
  }
}
