{
  "$schema": "https://datapackage.org/profiles/2.0/tableschema.json",
  "title": "IFN brut, ARBRE.csv",
  "description": "Colonnes lues par sylvigenese ; les autres colonnes de l'IFN sont admises ; W peut manquer. C13 : circonférence à 1,30 m en mm (docs/referentiels/ifn-placettes.md §2). Colonnes réelles à vérifier au jalon M1b.",
  "x-schema-version": "0.1",
  "x-names-fixed-by": "IFN, données brutes ; sylvostation R/placettes.R:121-123",
  "fieldsMatch": "subset",
  "fields": [
    {
      "name": "IDP",
      "type": "string",
      "description": "identifiant de placette IFN",
      "constraints": {
        "required": true,
        "minLength": 1
      }
    },
    {
      "name": "ESPAR",
      "type": "string",
      "description": "code espar, avec zéro de tête dans ARBRE",
      "constraints": {
        "required": true,
        "pattern": "[0-9]{2}[A-Z0-9]{0,3}"
      }
    },
    {
      "name": "C13",
      "type": "number",
      "description": "circonférence à 1,30 m",
      "x-unit": "mm",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "HTOT",
      "type": "number",
      "description": "hauteur totale",
      "x-unit": "m",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "V",
      "type": "number",
      "description": "volume",
      "x-unit": "m3",
      "constraints": {
        "minimum": 0
      }
    },
    {
      "name": "W",
      "type": "number",
      "description": "poids de l'arbre ; colonne facultative",
      "x-unit": "tiges/ha",
      "constraints": {
        "minimum": 0
      },
      "x-optional": true
    }
  ],
  "x-csv": {
    "delimiter": ";"
  }
}
